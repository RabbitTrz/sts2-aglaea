# ---------- Godot ----------
# 编辑器/导入缓存，1.7 GB 级别，绝不入库
.godot/
/android/

# 导出的资源包（构建产物，用 build_installer.sh 现生成）
*.pck

# ---------- .NET ----------
bin/
obj/
# 安装器发布出来的自包含 exe（104 MB）
dist/
# 安装器构建时填充的素材目录
tools/installer/payload/
# 发出去的压缩包与解压目录（每个 ~100-200 MB，不入库）
*.zip
tools/installer/AglaeaInstaller_Aglaea_*/
# 发布/创意工坊临时工作区（内含 pck/dll 等打包产物）
tools/release/
tools/workshop/
*.user
.vs/

# ---------- 其它 ----------
*.pdb
.DS_Store
Thumbs.db
